{
  "name": "splitdummy",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:shared": "vitest run --project shared",
    "test:worker": "vitest run --project worker",
    "test:web": "vitest run --project web",
    "e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "postinstall": "npm run cf-typegen",
    "deploy": "scripts/deploy.sh production",
    "deploy:staging": "scripts/deploy.sh staging"
  },
  "dependencies": {
    "hono": "4.13.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "4.1.12",
    "wrangler": "4.159.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261001.1": true,
    "esbuild@0.28.1": true
  }
}

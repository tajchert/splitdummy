{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splitdummy",
  "account_id": "7e814786800e88ac74b5acc9033370d4",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs (7 days), automatic traces, and Issues (grouped exceptions, 5xx and error logs).
  // Legacy sign-in links carry a token in the query string, so it never reaches logs or traces.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "traces": { "enabled": true },
    "issues": { "enabled": true }
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /assets/* goes through the worker so a missing hashed chunk is a real 404, not index.html.
    // /docs/api.md is the AI-tool guide, generated by the worker.
    "run_worker_first": ["/api/*", "/assets/*", "/docs/api.md"]
  },
  "routes": [
    { "pattern": "splitdummy.app", "custom_domain": true }
  ],
  "vars": {
    "APP_ORIGIN": "https://splitdummy.app",
    "EMAIL_FROM": "Splitdummy <hello@splitdummy.app>",
    "ENVIRONMENT": "production",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFNyE7Ukj_gERhnU"
  },
  // Turnstile widget "splitdummy" (0x4AAAAAAFNyE7Ukj_gERhnU). Deploy refuses to run without it.
  // First deploy of an env: wrangler deploy --secrets-file <0600 temp file with TURNSTILE_SECRET=...>
  // Rotate later: cf turnstile widgets get <sitekey> | jq -r '.secret // .result.secret' | wrangler secret put TURNSTILE_SECRET [--env staging]
  "secrets": { "required": ["TURNSTILE_SECRET"] },
  // Daily R2 backup of every project + D1 housekeeping.
  "triggers": { "crons": ["17 3 * * *"] },
  // Workers Rate Limiting; namespace_id must be unique per account (prod 1xxx, staging 2xxx).
  "ratelimits": [
    { "name": "RL_SIGNIN_IP", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_SIGNIN_EMAIL", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_CREATE_PROJECT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_JOIN", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_MUTATION", "namespace_id": "1005", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_CLIENT_ERROR", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_UPLOAD", "namespace_id": "1007", "simple": { "limit": 30, "period": 60 } }
  ],
  // One data point per API request (endpoint, status, latency); no user identifiers.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "splitdummy_requests" }],
  "durable_objects": {
    "bindings": [{ "name": "PROJECT", "class_name": "ProjectDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectDO"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitdummy-prod",
      "database_id": "f7e5ba1d-5842-41ee-b5a8-fb2d42824435",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "splitdummy-events" }],
    "consumers": [
      {
        "queue": "splitdummy-events",
        "max_batch_size": 25,
        "max_retries": 5,
        "dead_letter_queue": "splitdummy-events-dlq"
      }
    ]
  },
  "r2_buckets": [
    { "binding": "BACKUPS", "bucket_name": "splitdummy-backups" },
    { "binding": "ATTACHMENTS", "bucket_name": "splitdummy-attachments" }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "env": {
    "staging": {
      "name": "splitdummy-staging",
      "routes": [
        { "pattern": "staging.splitdummy.app", "custom_domain": true }
      ],
      "vars": {
        "APP_ORIGIN": "https://staging.splitdummy.app",
        "EMAIL_FROM": "Splitdummy Staging <hello@splitdummy.app>",
        "ENVIRONMENT": "staging",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFNyE7Ukj_gERhnU"
      },
      "secrets": { "required": ["TURNSTILE_SECRET"] },
      "triggers": { "crons": ["17 3 * * *"] },
      "ratelimits": [
        { "name": "RL_SIGNIN_IP", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_SIGNIN_EMAIL", "namespace_id": "2002", "simple": { "limit": 3, "period": 60 } },
        { "name": "RL_CREATE_PROJECT", "namespace_id": "2003", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_JOIN", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_MUTATION", "namespace_id": "2005", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_CLIENT_ERROR", "namespace_id": "2006", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_UPLOAD", "namespace_id": "2007", "simple": { "limit": 30, "period": 60 } }
      ],
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "splitdummy_staging_requests" }],
      "durable_objects": {
        "bindings": [{ "name": "PROJECT", "class_name": "ProjectDO" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "splitdummy-staging",
          "database_id": "31190111-8d70-497a-8c63-3017eeb41186",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "splitdummy-staging-events" }],
        "consumers": [
          {
            "queue": "splitdummy-staging-events",
            "max_batch_size": 25,
            "max_retries": 5,
            "dead_letter_queue": "splitdummy-staging-events-dlq"
          }
        ]
      },
      "r2_buckets": [
        { "binding": "BACKUPS", "bucket_name": "splitdummy-staging-backups" },
        { "binding": "ATTACHMENTS", "bucket_name": "splitdummy-staging-attachments" }
      ],
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
